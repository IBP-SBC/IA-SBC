# ─────────────────────────────────────────────────────────────────────
# Secrets de IA-SBC · EJEMPLO
#
# Este archivo NO lo lee la app. Es la plantilla de lo que se pega en
# Streamlit Cloud → la app → Settings → Secrets, cambiando los valores
# entre comillas. La auditoría lo lee y comprueba que la sintaxis TOML
# produzca exactamente la estructura que la app espera: en la v2.0 se
# documentó mal la sección de usuarios y nadie podía entrar.
#
# Las claves reales NUNCA van en el repositorio.
# ─────────────────────────────────────────────────────────────────────

# Modelo de lenguaje. Sin esta sección la app funciona en modo búsqueda.
[modelo]
proveedor = "google"
api_key   = "PEGAR_AQUI_LA_LLAVE_DE_AI_STUDIO"
modelo    = "gemini-flash-latest"

# Almacenamiento: bucket propio de esta app.
[supabase]
url    = "https://jvhcezarnzwkbnywaonw.supabase.co"
key    = "PEGAR_AQUI_LA_LLAVE_SECRETA"
bucket = "ia-sbc"

# Administradores. El nombre va ENTRE COMILLAS DENTRO del corchete,
# después de "usuarios.": así queda como una entrada de [usuarios].
# Escribirlo como ["usuarios.nombre"] crea otra sección y no funciona.
[usuarios."director.promocion@sbcol.org"]
clave = "PEGAR_AQUI_LA_CLAVE"
rol   = "admin"
